{
  "name": "maobuyi-cat-game",
  "version": "1.0.0",
  "description": "猫咪主题休闲剧情游戏",
  "main": "server/index.ts",
  "scripts": {
    "dev": "tsx watch server/index.ts",
    "build": "tsc",
    "start": "tsx server/index.ts",
    "type-check": "tsc --noEmit",
    "server": "tsx server/index.ts",
    "client": "python -m http.server 8000"
  },
  "dependencies": {
    "phaser": "^3.60.0",
    "express": "^4.18.2",
    "cors": "^2.8.5"
  },
  "devDependencies": {
    "@types/express": "^4.17.17",
    "@types/cors": "^2.8.13",
    "@types/node": "^20.0.0",
    "typescript": "^5.0.0",
    "tsx": "^4.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
} 